diff --git a/build/mac/find_sdk.py b/build/mac/find_sdk.py
--- a/build/mac/find_sdk.py
+++ b/build/mac/find_sdk.py
@@ -90,21 +90,33 @@
             + 'agreement, and run `sudo xcode-select -s /path/to/Xcode.app` '
             + 'to continue.'
         )
-    sdk_dir_list = os.listdir(sdk_dir)
-    sdks = [re.findall('^MacOSX(\d+\.\d+)\.sdk$', s) for s in sdk_dir_list]
-    sdks = [s[0] for s in sdks if s]  # [['10.5'], ['10.6']] => ['10.5', '10.6']
-    sdks = [
-        s
-        for s in sdks  # ['10.5', '10.6'] => ['10.6']
-        if parse_version(s) >= parse_version(min_sdk_version)
-    ]
-    if not sdks:
-        raise Exception(
-            f'No {min_sdk_version}+ SDK found. {sdk_dir} contains: {sdk_dir_list}'
-        )
-    best_sdk = sorted(sdks, key=parse_version)[0]
-    sdk_name = 'MacOSX' + best_sdk + '.sdk'
-    sdk_path = os.path.join(sdk_dir, sdk_name)
+    # Conductor selects one SDK for both bindgen and Chromium. Report its
+    # version and build here instead of those of the active Xcode's SDK.
+    sdk_root = os.environ.get('SDKROOT')
+    if sdk_root:
+        sdk_path = os.path.realpath(sdk_root)
+        with open(os.path.join(
+            sdk_path, 'System/Library/CoreServices/SystemVersion.plist'
+        ), 'rb') as f:
+            best_sdk = plistlib.load(f)['ProductVersion']
+        if parse_version(best_sdk) < parse_version(min_sdk_version):
+            raise SdkError(f'SDKROOT must provide macOS {min_sdk_version}+ SDK')
+    else:
+        sdk_dir_list = os.listdir(sdk_dir)
+        sdks = [re.findall(r'^MacOSX(\d+\.\d+)\.sdk$', s) for s in sdk_dir_list]
+        sdks = [s[0] for s in sdks if s]  # [['10.5'], ['10.6']] => ['10.5', '10.6']
+        sdks = [
+            s
+            for s in sdks  # ['10.5', '10.6'] => ['10.6']
+            if parse_version(s) >= parse_version(min_sdk_version)
+        ]
+        if not sdks:
+            raise Exception(
+                f'No {min_sdk_version}+ SDK found. {sdk_dir} contains: {sdk_dir_list}'
+            )
+        best_sdk = sorted(sdks, key=parse_version)[0]
+        sdk_name = 'MacOSX' + best_sdk + '.sdk'
+        sdk_path = os.path.join(sdk_dir, sdk_name)

     if options.print_sdk_path:
         print(sdk_path)
diff --git a/tools/rust/build_bindgen.py b/tools/rust/build_bindgen.py
