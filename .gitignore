# macOS metadata
.DS_Store
.AppleDouble
.LSOverride

# Local editor state
.vscode/
.idea/
*.swp
*~

# Generated logs and local build-state markers
/out/
*.log
.conductor-last-built-version
# Legacy (pre-rename) marker; kept ignored during the forge.sh -> conductor.sh transition.
.forge-last-built-version
# Generated local version state: the release this machine last selected. Conductor
# builds the latest upstream release by default, so this is not a committed pin.
version.txt

# Managed/downloaded Chromium checkout and generated build state
/ungoogled-chromium-macos/

# conductor.sh staged-deletion trash (transient; lingers only if a delete could not finish)
/.conductor-trash-*/
# Legacy (pre-rename) staged-deletion trash; kept ignored in case an old run left one behind.
/.forge-trash-*/
